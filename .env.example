# kc-booth Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# Database Configuration
POSTGRES_DB=kc-booth-db
POSTGRES_USER=kc-booth-user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Encryption Key (generate with: python3 generate_encryption_key.py)
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_SCRIPT

# Step-CA Configuration
STEP_PROVISIONER_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Authentication (set to true ONLY for local development)
DISABLE_AUTH=false

# Rate Limiting (optional - defaults shown)
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute

# Testing Mode (only for local development)
TEST_MODE=false

# Certificate Provider (step-ca, openssh, vault, letsencrypt)
CERT_PROVIDER=step-ca

# Vault Configuration (only if CERT_PROVIDER=vault)
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=your-vault-token
# VAULT_SSH_PATH=ssh/sign/default
